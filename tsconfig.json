{
  "compilerOptions": {
    "target": "ES2020", // 升级到较新的 ECMAScript 版本，支持更多现代特性
    "module": "CommonJS", // 指定模块代码生成：'none'、'commonjs'、'amd'、'system'、'umd'、'es2015' 或 'ESNext'
    "lib": ["ES2020"], // 使用与 target 版本匹配的库，减少冗余

    "rootDir": "./", // 你的 TS 都在根目录及子目录
    "outDir": "./dist", // 输出到 dist，用于 PM2 生产环境

    "strict": true, // 启用所有严格类型检查选项
    "moduleResolution": "node", // 使用 Node.js 的模块解析策略
    "esModuleInterop": true, // 启用 CommonJS 模块与 ES 模块的互操作性
    "allowSyntheticDefaultImports": true,

    "experimentalDecorators": true /* Enables experimental support for ES7 decorators. */,
    "emitDecoratorMetadata": true, // 启用实验性的装饰器元数据功能

    "skipLibCheck": true, // 跳过声明文件检查，提升编译速度
    "forceConsistentCasingInFileNames": true, // 强制文件名大小写一致，避免跨平台问题

    "resolveJsonModule": true, // 支持导入 JSON 文件

    "sourceMap": true, // 方便调试（VSCode 可直接跳转 TS 源码）
    "baseUrl": ".", // 根路径
    "paths": {
      // 你可以用别名（可选）
      "@/*": ["./*"]
    }
  },

  "include": [
    "app.ts",
    "controllers/**/*",
    "routes/**/*",
    "middleware/**/*",
    "models/**/*",
    "service/**/*",
    "util/**/*",
    "db/**/*",
    "json/**/*",
    "public/**/*"
  ],

  "exclude": ["node_modules", "dist", "logs"]
}
