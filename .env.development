PORT=3001 # 应用端口号

# MySQL
MYSQL_HOST=127.0.0.1 # MySQL主机地址
MYSQL_PORT=3306 # MySQL端口号
MYSQL_USER=root # 测试数据库用户
MYSQL_PASSWORD=12345678 # 测试数据库密码
MYSQL_DATABASE=expenses # 测试数据库名称
MYSQL_POOL_LIMIT=10 # 数据库连接池最大连接数

# Redis
REDIS_HOST=localhost # Redis主机地址
REDIS_PORT=6379 # Redis端口号
REDIS_DB=0 # Redis数据库索引

# jwt
JWT_SECRET=wongtaisin # JWT密钥

# 文件上传大小限制5M
FILE_UPLOAD_SIZE=5242880
